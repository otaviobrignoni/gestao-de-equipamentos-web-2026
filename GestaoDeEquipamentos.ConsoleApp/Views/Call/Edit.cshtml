@{
    ViewBag.Titulo = "Edição de Chamado";
    
    List<SelectListItem> selecionarEquipamentos = ViewBag.Equipments;
}

@model CallViewModel;

<form class="formulario" asp-action="Edit" asp-route-id="@Model.Id" method="post">
    <div class="formulario-campo">
        <label asp-for="Title">Título</label>
        <input asp-for="Title" type="text">
        <span asp-validation-for="Title" class="formulario-validacao-campo"></span>
    </div>

    <div class="formulario-campo">
        <label asp-for="Description">Descrição</label>
        <textarea asp-for="Description"></textarea>
        <span asp-validation-for="Description" class="formulario-validacao-campo"></span>
    </div>

    <div class="formulario-campo">
        <label asp-for="EquipmentId">Equipamento</label>
        <select asp-for="EquipmentId" asp-items="selecionarEquipamentos">
            <option value="">Selecione um equipamento</option>
        </select>
        <span asp-validation-for="EquipmentId" class="formulario-validacao-campo"></span>
    </div>

        <div class="formulario-campo">
        <label style="display: flex; align-items: center; gap: 10px;">
            <input asp-for="IsDone" type="checkbox" style="width: auto;">
            Concluído
        </label>
    </div>
    
    <div class="formulario-acoes">
        <a asp-action="Index">Voltar</a>
        <button type="submit">Confirmar</button>
    </div>
</form>