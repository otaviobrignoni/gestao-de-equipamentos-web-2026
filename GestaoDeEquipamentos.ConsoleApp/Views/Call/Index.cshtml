@{
    ViewBag.Titulo = "Listagem de Chamados";
}

@model IEnumerable<CallShowViewModel>

<a class="btn-cadastrar" asp-action="Add">Cadastrar Novo</a>


<div class="filtros-listagem">
    <a class="@(string.IsNullOrWhiteSpace(ViewBag.StatusSelecionado) ? "ativo" : "")" asp-action="Index">Todos</a>
    <a class="@(ViewBag.StatusSelecionado == "em-aberto" ? "ativo" : "")" asp-action="Index" asp-route-status="em-aberto">Em Aberto</a>
    <a class="@(ViewBag.StatusSelecionado == "concluidos" ? "ativo" : "")" asp-action="Index" asp-route-status="concluidos">Concluídos</a>
</div>

@if (Model.Count() == 0)
{
    <p class="formulario-alerta">Nenhum chamado cadastrado.</p>
}
else
{
    <table class="registros">
        <thead>
            <tr>
                <th>ID</th>
                <th>Título</th>
                <th>Equipamento</th>
                <th>Data de Abertura</th>
                <th>Tempo Decorrido</th>
                <th>Status</th>
                <th>Ações</th>
            </tr>
        </thead>
        <tbody>
            @foreach (CallShowViewModel c in Model)
            {
                <tr>
                    <td data-label="ID">@c.Id</td>
                    <td data-label="Titulo">@c.Title</td>
                    <td data-label="Equipamento">@c.Equipment</td>
                    <td data-label="Data de Abertura">@c.OpeningDate.ToString("dd/MM/yyyy")</td>
                    <td data-label="Tempo Decorrido">@c.ElapsedTime dia(s)</td>
                    <td data-label="Status">@(c.IsDone ? "Concluído" : "Aberto")</td>
                    <td data-label="Ações">
                        <a asp-action="Edit" asp-route-id="@c.Id">Editar</a>
                        <a asp-action="Remove" asp-route-id="@c.Id">Excluir</a>
                    </td>
                </tr>
            }
        </tbody>
    </table>
}