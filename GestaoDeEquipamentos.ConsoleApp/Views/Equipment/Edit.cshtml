@{
    ViewBag.Titulo = "Edição de Equipamento";

    List<SelectListItem> selecionarFabricantes = ViewBag.Manufacturers;
}

@model EquipmentViewModel;

<form class="formulario" asp-action="Edit" asp-route-id="@Model.Id" method="post">
    <input asp-for="Id" type="hidden">

    <div class="formulario-campo">
        <label asp-for="Name">Nome</label>
        <input asp-for="Name" type="text">
        <span asp-validation-for="Name" class="formulario-validacao-campo"></span>
    </div>

    <div class="formulario-campo">
        <label asp-for="Price">Preço de Aquisição</label>
        <input asp-for="Price" type="number" min="0.01" step="0.01">
        <span asp-validation-for="Price" class="formulario-validacao-campo"></span>
    </div>
    
    <div class="formulario-campo">
        <label asp-for="Date">Data de Fabricação</label>
        <input asp-for="Date" type="date">
        <span asp-validation-for="Date" class="formulario-validacao-campo"></span>
    </div>

    <div class="formulario-campo">
        <label asp-for="ManufacturerId">Fabricante</label>
        <select asp-for="ManufacturerId" asp-items="selecionarFabricantes">
            <option value="">Selecione um fabricante</option>
        </select>
        <span asp-validation-for="ManufacturerId" class="formulario-validacao-campo"></span>
    </div>

    <div class="formulario-acoes">
        <a asp-action="Index">Voltar</a>
        <button type="submit">Confirmar</button>
    </div>
</form>